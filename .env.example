# Trainer HQ — server-side only. Set these in Vercel → Project → Settings →
# Environment Variables, and copy this file to .env for local work.
# None of them are ever sent to a browser.
#
# The page itself has no sign-in. It is unlisted, noindex, and in no sitemap,
# but anyone with the URL can read it — including former staff. Share the link
# with that in mind.

# --- Events ----------------------------------------------------------------
# OPTIONAL. Events already work without this: the public events service is the
# built-in default. Set it only to point at something else, such as a staging
# feed or the Apps Script web app.
EVENTS_FEED_URL=
EVENTS_FEED_TOKEN=

# --- Announcements, the 1,000, and studio issues ---------------------------
# The Apps Script web app bound to the events workbook. It serves the
# ANNOUNCEMENTS and SITE CONFIG tabs and accepts issue reports. Optional: without
# it, events still work and those three panels say they are not connected.
# See tools/apps-script/ocp-events-feed.gs for the script and how to deploy it.
WORKBOOK_FEED_URL=
WORKBOOK_FEED_TOKEN=

# --- The 1,000 -------------------------------------------------------------
# The membership count, when the workbook's SITE CONFIG tab is not supplying
# it. Arketa holds the real figure; nothing here can reach it automatically, so
# this is a number somebody updates and the page dates it accordingly.
#
# From Arketa's "Active subscriptions" report, counted 17 Sep 2026:
#   677  substatus "active"
#   707  + canceling (still entitled, leaving at term end)  <- recommended
#   733  + trialing and past due
#   833  + paused
#   886  everything Arketa files under active
#
# These count subscriptions, not people: a Couples Unlimited is one
# subscription for two members, and one person can hold more than one.
MEMBER_COUNT=
MEMBER_GOAL=1000
MEMBER_COUNT_UPDATED=
