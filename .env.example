# Trainer HQ — server-side only. Set these in Vercel → Project → Settings →
# Environment Variables, and copy this file to .env for local work.
# Neither is ever sent to a browser.
#
# The page itself has no sign-in. It is unlisted, noindex, and in no sitemap,
# but anyone with the URL can read it — including former staff. Share the link
# with that in mind.

# --- Events, announcements and studio issues -------------------------------
# The Apps Script web app bound to the events workbook. It serves the feed and
# accepts issue reports. See tools/apps-script/ocp-events-feed.gs for the
# script and how to deploy it.
EVENTS_FEED_URL=
EVENTS_FEED_TOKEN=
