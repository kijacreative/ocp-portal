# Trainer HQ — server-side only. Set these in Vercel → Project → Settings →
# Environment Variables, and copy this file to .env for local work.
# None of them are ever sent to a browser.
#
# The page itself has no sign-in. It is unlisted, noindex, and in no sitemap,
# but anyone with the URL can read it — including former staff. Share the link
# with that in mind.

# --- Events ----------------------------------------------------------------
# The events service. Public, no token needed.
EVENTS_FEED_URL=https://events.oakcliffpilates.com/api/feed
EVENTS_FEED_TOKEN=

# --- Announcements, the 1,000, and studio issues ---------------------------
# The Apps Script web app bound to the events workbook. It serves the
# ANNOUNCEMENTS and SITE CONFIG tabs and accepts issue reports. Optional: without
# it, events still work and those three panels say they are not connected.
# See tools/apps-script/ocp-events-feed.gs for the script and how to deploy it.
WORKBOOK_FEED_URL=
WORKBOOK_FEED_TOKEN=
