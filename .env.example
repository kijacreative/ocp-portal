# Trainer HQ — server-side only. Set these in Vercel → Project → Settings →
# Environment Variables, and copy this file to .env for local work.
# None of them are ever sent to a browser.

# --- Session signing -------------------------------------------------------
# Any long random string. Rotating it signs everyone out.
#   openssl rand -hex 32
HQ_SESSION_SECRET=

# --- Sign in with Slack (OpenID Connect) -----------------------------------
# api.slack.com/apps → your app → Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Only this workspace may sign in. Slack → About this workspace → Workspace ID.
SLACK_TEAM_ID=

# --- Slack bot (announcements feed + posting studio issues) ----------------
# OAuth & Permissions → Bot User OAuth Token. Scopes:
#   channels:history, channels:read, users:read, chat:write
# Invite the bot to both channels: /invite @OCP Trainer HQ
SLACK_BOT_TOKEN=
SLACK_ANNOUNCEMENTS_CHANNEL=general
SLACK_ISSUES_CHANNEL=studio-issues

# --- Events feed (Apps Script web app bound to the events workbook) --------
# See tools/apps-script/ocp-events-feed.gs for the script and how to deploy it.
EVENTS_FEED_URL=
EVENTS_FEED_TOKEN=

