# Trainer HQ — server-side only. Set these in Vercel → Project → Settings →
# Environment Variables, and copy this file to .env for local work.
# None of them are ever sent to a browser.
#
# The page itself has no sign-in. It is unlisted, noindex, and in no sitemap,
# but anyone with the URL can read it — including former staff. Share the link
# with that in mind.

# --- Events ----------------------------------------------------------------
# OPTIONAL. Events already work without this: the public events service is the
# built-in default. Set it only to point at something else, such as a staging
# feed or the Apps Script web app.
EVENTS_FEED_URL=
EVENTS_FEED_TOKEN=

# --- Announcements ---------------------------------------------------------
# A Google Sheet published to the web as CSV. No credential, no Apps Script, no
# Slack app.
#
# The intended setup is a Google Form -> its response sheet -> published:
#   1. New form, three questions: Title, Message, Link (link not required).
#   2. Responses tab -> Link to Sheets -> create.
#   3. In that sheet: File -> Share -> Publish to web -> the responses tab,
#      "Comma-separated values (.csv)" -> Publish. Paste that URL below.
# Nothing needs renaming: the Timestamp/Title/Message/Link headers a form
# produces are read as-is. A sheet somebody types into works too, with
# Date/Title/Body/Link and an optional Show On Site column to hide a row.
#
# To mirror Slack in without building a Slack app, add a Zap:
#   Slack "New Message Posted to Channel" -> Google Sheets "Create Spreadsheet Row"
#
# Published sheets are cached by Google for a few minutes, so a new
# announcement is not instant.
ANNOUNCEMENTS_CSV_URL=

# --- Studio issues ---------------------------------------------------------
# A Google Form. The server posts the response exactly as a browser would, so
# answers land in the form's spreadsheet — no credential anywhere.
#
#   Build the form with: Your name / Studio / What it relates to / What needs
#   attention / Urgent. Then Send -> link, and swap the /viewform tail for
#   /formResponse. To find each field id, open the live form, View Source and
#   search for "entry." — each question has one.
#
#   To email info@oakcliffpilates.com on every report: in the form's responses
#   spreadsheet, Tools -> Notification settings -> notify me immediately. The
#   address that gets it is whoever owns the sheet, so make that info@ (or
#   share it to info@ and have them set their own rule).
ISSUE_FORM_URL=
ISSUE_FORM_FIELDS={"reporter":"entry.","location":"entry.","area":"entry.","detail":"entry.","urgent":"entry."}

# --- The Apps Script, if it is ever deployed -------------------------------
# The Apps Script web app bound to the events workbook. It serves the
# ANNOUNCEMENTS and SITE CONFIG tabs and accepts issue reports. Optional: without
# it, events still work and those three panels say they are not connected.
# See tools/apps-script/ocp-events-feed.gs for the script and how to deploy it.
WORKBOOK_FEED_URL=
WORKBOOK_FEED_TOKEN=

# --- The 1,000 -------------------------------------------------------------
# The membership count, when the workbook's SITE CONFIG tab is not supplying
# it. Arketa holds the real figure; nothing here can reach it automatically, so
# this is a number somebody updates and the page dates it accordingly.
#
# From Arketa's "Active subscriptions" report, counted 17 Sep 2026:
#   677  substatus "active"
#   707  + canceling (still entitled, leaving at term end)  <- recommended
#   733  + trialing and past due
#   833  + paused
#   886  everything Arketa files under active
#
# These count subscriptions, not people: a Couples Unlimited is one
# subscription for two members, and one person can hold more than one.
MEMBER_COUNT=
MEMBER_GOAL=1000
MEMBER_COUNT_UPDATED=
